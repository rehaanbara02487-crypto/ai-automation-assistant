# =============================================================================
# BeingAI Assistant — Frontend environment (copy to frontend/.env.local)
# =============================================================================
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# Never put secrets (service role, OpenAI, n8n API keys) in this file.
# =============================================================================

# --- REQUIRED in production ---
# Public URL of this Next.js app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- REQUIRED in production: Auth (Clerk) ---
# Dashboard → API Keys → Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Required by Clerk middleware on the Next.js server; never exposed to the browser.
CLERK_SECRET_KEY=

# Clerk JWT issuer also belongs in backend/.env so FastAPI can verify bearer tokens.

# --- Optional: Supabase (client-side reads only; MVP uses backend API today) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
