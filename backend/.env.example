# =============================================================================
# BeingAI Assistant — Backend environment (copy to backend/.env)
# =============================================================================
# Local development: configure Clerk and DATABASE_URL before using protected APIs.
# Production: set APP_ENV=production and fill all REQUIRED sections below.
# =============================================================================

# --- Core ---
# development | production
APP_ENV=development

# Comma-separated browser origins allowed to call this API (no trailing slash)
# Local:  http://localhost:3000,http://127.0.0.1:3000
# Prod:   https://your-app.vercel.app
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- REQUIRED: Database (Supabase Postgres) ---
# Supabase Project Settings -> Database -> Connection string.
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Optional: Supabase project metadata ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- REQUIRED in production: Auth (Clerk) ---
# Dashboard → API Keys → Secret key
CLERK_SECRET_KEY=
# Dashboard → Frontend API URL (JWT issuer), e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER=

# --- Optional: AI (OpenAI) ---
# If empty, backend uses deterministic fallback planner (fine for demos)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Optional: Automation engine (n8n) ---
# If empty, workflows run in mock-n8n mode (fine for demos)
N8N_BASE_URL=
N8N_API_KEY=
# Optional webhook base for manual runs, e.g. https://n8n.example.com/webhook
N8N_WEBHOOK_BASE_URL=

# --- Optional: Gmail sending (Google OAuth2) ---
# Required for POST /api/gmail/send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Optional: Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
